NODE_ENV=development
PORT=5050

# Local: mongodb://127.0.0.1:27017/evenplanner  |  Atlas: mongodb+srv://user:pass@cluster/evenplanner
MONGO_URI=mongodb://127.0.0.1:27017/evenplanner

# Long random strings (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
# Signs QR tickets. Changing it invalidates every QR already sent.
QR_SECRET=change-me-to-another-long-random-string-32-chars-min

# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173
# Public API base Twilio uses to fetch QR PNGs for MMS (no trailing slash).
# Defaults to CLIENT_URL + "/api". Set explicitly in production / when using a tunnel.
# API_PUBLIC_URL=https://your-domain.com/api
# Used inside "branded" QR codes
VERIFY_BASE_URL=https://eventsphere.app/verify

# Email: "smtp" sends for real, "log" only prints to the console (for local testing)
# SMTP_USER / SMTP_PASS are the defaults. An admin can override them from
# Administration → Email Settings in the panel (host/port/TLS still use these env values).
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="EventSphere <you@gmail.com>"

# Twilio SMS only (Messages API — no voice calls). "sms" sends for real; "log" prints to console.
# An admin can override SID / token / from-number from Administration → Twilio Settings.
TWILIO_TRANSPORT=sms
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+14155552671

# First admin account, created by `npm run seed:admin`
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@eventsphere.com
ADMIN_PASSWORD=ChangeMe123!
